# Yaoundé GlobeTrotter — Environment Configuration Template
# Copy this file to .env and fill in your confidential keys.

# --- Online PostgreSQL (Neon) ---
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Per-service database URLs (optional overrides)
USER_DATABASE_URL=
ITINERARY_DATABASE_URL=
RECOMMENDATION_DATABASE_URL=

# --- Shared Secret for JWT Signing ---
SECRET_KEY=generate_a_random_256bit_hex_secret_here

# --- CORS & Security ---
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8080,http://localhost:5000
