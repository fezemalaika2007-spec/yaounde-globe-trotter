# =============================================================================
# GlobeTrotter environment variables (copy to `.env` and fill in — NEVER commit
# the real `.env` to version control).
# =============================================================================

# --- Foursquare Places API (Recommendation Service) ---
# Sign up at https://location.foursquare.com/developer/ and generate a key.
FOURSQUARE_API_KEY=

# --- Online PostgreSQL connection strings (Neon) ---
# Create a database/schema for each service on your Neon project.
# You can use the same connection string for all three (each service uses
# its own table set), or create separate databases per service.
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require

# Optionally, separate connection strings per service (fall back to DATABASE_URL):
USER_DATABASE_URL=
ITINERARY_DATABASE_URL=
RECOMMENDATION_DATABASE_URL=

# --- General ---
SECRET_KEY=change-me-in-production
